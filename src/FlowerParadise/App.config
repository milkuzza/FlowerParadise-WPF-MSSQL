<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup useLegacyV2RuntimeActivationPolicy="true">
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
    </startup>
    <connectionStrings>
        <add name="FlowerParadise" connectionString="Data Source=(LocalDB)\MSSQLLocalDB;Initial Catalog=FlowerParadise;Integrated Security=True;Connect Timeout=15;Application Name=FlowerParadise" providerName="System.Data.SqlClient"/>
    </connectionStrings>
</configuration>
